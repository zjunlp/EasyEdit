# ROME on Qwen3.8-27B — SCAFFOLD ONLY. Do not claim ROME works.
#
# Causal tracing and mom2 covariance are unverified on GDN (linear_attn)
# layers. Recurrent GDN state can make noise experiments fail. Wait for
# rewrite+locality from examples/qwen38/04_layer_scan.py before promoting
# this file to a real yaml.
#
# Module path prefix is model.language_model.layers.{}.
# Attention module name depends on layer type:
#   full_attention layers (3, 7, ..., 63): self_attn
#   GDN / linear_attention layers (the other 48): linear_attn
# Default attn_module_tmp below is self_attn (full_attention). Swap to
# linear_attn only if you intentionally target a GDN layer.
alg_name: "ROME"
model_name: "./hugging_cache/Qwen3.8-27B"
stats_dir: "./data/stats"
device: 0

layers: [53]
fact_token: "subject_last"
v_num_grad_steps: 25
v_lr: 5e-1
v_loss_layer: 63
v_weight_decay: 1e-3
clamp_norm_factor: 4
kl_factor: 0.0625
mom2_adjustment: false
context_template_length_params: [[5, 10], [10, 10]]
rewrite_module_tmp: "model.language_model.layers.{}.mlp.down_proj"
layer_module_tmp: "model.language_model.layers.{}"
mlp_module_tmp: "model.language_model.layers.{}.mlp"
attn_module_tmp: "model.language_model.layers.{}.self_attn"
ln_f_module: "model.language_model.norm"
lm_head_module: "lm_head"
mom2_dataset: "wikipedia"
mom2_n_samples: 100000
mom2_dtype: "float32"
model_parallel: false
fp16: false
